# Copy this file to backend/.env. Never commit backend/.env.
#
# Repository chat uses a locally running Ollama service. Install Ollama, then
# pull the selected model (for example: `ollama pull qwen2.5-coder:7b`).
ARCHAI_OLLAMA_BASE_URL=http://127.0.0.1:11434
ARCHAI_OLLAMA_MODEL=qwen2.5-coder:7b
ARCHAI_OLLAMA_TIMEOUT_SECONDS=240

# Adaptive chat retrieval. Repositories at or below the chunk limit use local
# embeddings plus FAISS. Larger repositories use SQLite FTS/BM25. If the local
# model is unavailable, ArchAI continues with keyword retrieval.
ARCHAI_EMBEDDING_MODEL=jinaai/jina-embeddings-v2-base-code
ARCHAI_FULL_EMBEDDING_CHUNK_LIMIT=7000
ARCHAI_EMBEDDING_BATCH_SIZE=16
ARCHAI_EMBEDDING_TIMEOUT_SECONDS=900
ARCHAI_EMBEDDING_LOCAL_FILES_ONLY=true
ARCHAI_EMBEDDING_DEVICE=cpu

# Revision-aware JSON artifacts and disposable repository checkouts.
ARCHAI_WORKSPACE_DIR=data/workspaces

# Maximum time allowed for remote Git inspection or clone operations.
ARCHAI_CLONE_TIMEOUT_SECONDS=900

# Comma-separated frontend origins permitted to call the local API.
ARCHAI_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
